{
  "name": "@arvato-systems-jacs/t9t-api",
  "version": "0.0.0",
  "description": "Typed TypeScript API for t9t, including the shared Angular rpc-core.",
  "sideEffects": false,
  "scripts": {
    "prepare:workspace": "node scripts/prepare-package-workspace.mjs",
    "assemble:generated": "node scripts/assemble-generated-sources.mjs",
    "prebuild": "npm run assemble:generated",
    "build": "ng-packagr -p ng-package.json -c tsconfig.lib.prod.json",
    "package:artifact": "node scripts/package-artifact.mjs",
    "publish:package": "node scripts/publish-package.mjs",
    "size-gate": "node scripts/check-size-gate.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@angular/common": "^22.0.0",
    "@angular/core": "^22.0.0",
    "rxjs": "^7.4.0",
    "@arvato-systems-jacs/bonaparte-typescript": ">=0.1.0-snapshot <0.1.0"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/common": "~22.2.0",
    "@angular/compiler": "~22.2.0",
    "@angular/core": "~22.2.0",
    "@angular/platform-browser": "~22.2.0",
    "@angular/platform-browser-dynamic": "~22.2.0",
    "@angular/compiler-cli": "~22.2.0",
    "esbuild": "~0.28.0",
    "jsdom": "^28.0.0",
    "ng-packagr": "~22.2.0",
    "rxjs": "~7.8.0",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8",
    "zone.js": "~0.15.0"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arvato-systems-jacs/t9t.git"
  },
  "license": "Apache-2.0"
}
