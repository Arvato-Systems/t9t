import t9t.base.types.*

/**
 * Data structures to define a JSON schema.
 */
package (com.arvatosystems) t9t.ai.jsonSchema {
    default private unsigned trim noControlChars;
    properties jsonName is com.fasterxml.jackson.annotation.JsonProperty();

    /**
     * Information to describe a single field of any type (common superclass).
     * While title and description can both be used in object definitions and references (refs and defs), we use the following convention here:
     * - title is only used for objects, and is unique to the class
     * - description is used for fields referencing the object (or other fields), and is the instance comment
     */
    abstract class AbstractJsonSchemaField {
        optional Element                                    ^type;              // usually string or, with OpenAI workaround: [ (type), "null" ]. Optional, because for refs it is not used.
        optional Unicode(65535)                             description;        // describes the use of the referenced field (field comment)
    }

    /**
     * Information to describe an object.
     * This can be a specific type, or a ref, or anyOf.
     * Exactly one of the fields will be populated - ref or anyOf or (type, title, properties, required, addProps).
     */
    final class JsonSchemaObject extends AbstractJsonSchemaField {
        optional Unicode(65535)                             title;              // describes the object (class comment)
        required (AbstractJsonSchemaField...) Map<String>   ^properties;
        required defaultExternalId List<>                   ^required;
        optional Boolean                                    addProps    properties jsonName="additionalProperties"; // no snake case here!
        required (JsonSchemaObject) Map<String>             defs        properties jsonName="$defs";        // all object definitions
        optional Unicode(255)                               ref         properties jsonName="$ref";
        required Element List<>                             anyOf       properties jsonName="anyOf";        // elements can be of type JsonSchemaObject or String (for "null")
    }

    /** Information to describe a string field (this includes temporal types). */
    final class JsonSchemaString extends AbstractJsonSchemaField {
        optional Integer                                    minLength   properties jsonName="minLength";    // no snake case here!
        optional Integer                                    maxLength   properties jsonName="maxLength";    // no snake case here!
        optional Unicode(255)                               pattern;
        optional Unicode(255)                               format;
    }

    /** Information to describe an enum field. */
    final class JsonSchemaEnum extends AbstractJsonSchemaField {
        required defaultExternalId required List<>          enums       properties jsonName="enum";         // using enum directly here causes compile error
    }

    /** Information to describe a boolean field. */
    final class JsonSchemaBoolean extends AbstractJsonSchemaField {
    }

    /** Information to describe a numeric field. None additional fields because the defined properties are not supported in bonaparte. */
    final class JsonSchemaNumber extends AbstractJsonSchemaField {
    }

    /** Information to describe an array field. */
    final class JsonSchemaArray extends AbstractJsonSchemaField {
        optional Integer                                    minItems    properties jsonName="minItems";     // minimum number of entries
        optional Integer                                    maxItems    properties jsonName="maxItems";     // maximum number of entries
        optional (AbstractJsonSchemaField...)               items;                                          // type of the items
    }

    /** Information to describe a set field. */
    final class JsonSchemaSet extends AbstractJsonSchemaField {
        optional Boolean                                    uniqueItems properties jsonName="uniqueItems";  // must be true! But not supported by OpenAI!
        optional (AbstractJsonSchemaField...)               items;              // type of the items
    }
}
