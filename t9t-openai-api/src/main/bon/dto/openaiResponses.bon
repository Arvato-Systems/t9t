import api.*
import apiw.*
import t9t.base.types.*
import t9t.ai.*
import t9t.ai.openai.*

/**
 * OpenAI data structures for the Responses API (/v1/responses).
 * Replaces the deprecated Assistants API (threads / runs).
 */
package (com.arvatosystems) t9t.ai.openai.responses {
    default private unsigned trim noControlChars;
    properties path, jsonName is com.fasterxml.jackson.annotation.JsonProperty();

    /** Status values returned by the Responses API. */
    enum OpenAIResponseStatusType {
        COMPLETED               = "completed",
        FAILED                  = "failed",
        IN_PROGRESS             = "in_progress",
        CANCELLED               = "cancelled",
        QUEUED                  = "queued",
        INCOMPLETE              = "incomplete"
    }

    /**
     * A single input item for the Responses API.
     * type = "message"               -> use role + content fields.
     * type = "function_call_output"  -> use callId + output fields.
     */
    final class OpenAIResponseInputItem {
        required openaiId                           ^type;          // "message" or "function_call_output"
        optional Enum OpenAIRoleType                role;           // user, assistant, system (for type="message")
        required (OpenAIResponseInputContent) List<> content;       // list of input items
        optional openaiId                           callId;         // function call ID (for type="function_call_output")
        optional textChunk                          output;         // tool result text (for type="function_call_output")
        optional Object                             value;          // if type = "input_json"
    }

    final class OpenAIResponseInputContent {
        required openaiId                           ^type;          // "message" or "function_call_output"
        optional textChunk                          text;           // if type = "input_text"
        optional Unicode(255)                       imageUrl;       // if type = "input_image"
        optional Object                             value;          // if type = "input_json"
    }

    /**
     * A single content item within a message output from the Responses API.
     * type = "output_text" -> text field is set.
     */
    final class OpenAIResponseOutputContent {
        required openaiId                           ^type;          // "output_text"
        optional textChunk                          text;           // the text generated by the model
        optional Array                              annotations;    // annotations on the text
    }

    /**
     * A single output item from the Responses API.
     * type = "message"       -> id, role, content, status fields are populated.
     * type = "function_call" -> id, callId, name, arguments, status fields are populated.
     */
    final class OpenAIResponseOutputItem {
        required openaiId                           ^type;          // "message" or "function_call"
        optional openaiId                           id;             // item ID
        optional openaiText                         role;           // "assistant" (for type="message")
        optional (OpenAIResponseOutputContent) List<> content;      // content items (for type="message")
        optional openaiId                           callId;         // function call ID (for type="function_call")
        optional Ascii(64) regexp "[A-Za-z0-9_-]+"  name;           // function name (for type="function_call")
        optional Unicode(16384) allowControlChars   arguments;      // JSON arguments (for type="function_call")
        optional openaiText                         status;         // "completed", "in_progress", "incomplete"
    }

    /**
     * Request object for POST /v1/responses.
     * This replaces the thread + run workflow of the Assistants API.
     */
    final class OpenAICreateResponseReq extends OpenAIReq {
        properties path="/v1/responses";
        required openaiModel                        model;
        required (OpenAIResponseInputItem) List<>   input;              // one or more input items
        optional (OpenAIResponseInputJsonFormat)    text;               // a wrapped JSON schema specification for structured output
        optional openaiText                         instructions;       // system-level instructions (replaces assistant.instructions)
        optional openaiId                           previousResponseId; // links to prior response for multi-turn conversation
        required (OpenAITool) List<>                tools;              // available tools (function calls, file search, code interpreter)
        optional Float                              temperature;        // level of randomness
        optional Float                              topP;               // token selection limit
        optional Integer                            maxOutputTokens;    // maximum number of tokens to produce
        optional Boolean                            store;              // whether to store the response server-side (default: true)
        optional (OpenAiReasoning)                  reasoning;          // populated if at least one of the optional members is not null
    }

    class OpenAiReasoning {
        optional Ascii(20)                          context;
        optional Ascii(20)                          effort;
        optional Ascii(20)                          mode;
        optional Ascii(20)                          summary;
    }

    /** Specification of the desired output.
     * "format" is an object with the following structure:
     {
      "type": "json_schema",
      "name": "(name of the DTO)",
      "schema": {
        "type": "object",
        "properties": {
        ....
     */
    class OpenAIResponseInputJsonSchema {
        required openaiId                           ^type;             // "json_schema"
        required Ascii(60)                          name;              // name of the DTO
        optional Boolean                            strict;            // instruction to follow the schema strictly
        required Object                             schema;            // the JSON schema
        required boolean                            additionalProperties properties jsonName="additionalProperties";  // required by OpenAI
    }

    class OpenAIResponseInputJsonFormat {
        required (OpenAIResponseInputJsonSchema)    format;            // the JSON schema
        optional Ascii(20)                          verbosity;         // verbosity of the result text elements
    }

    /**
     * Response object from POST /v1/responses.
     * The id should be stored as providerThreadId to enable multi-turn conversations.
     */
    final class OpenAIResponseResult extends AbstractOpenAIObject {     // OpenAIObjectType.RESPONSE
        required openaiId                           id;                 // response ID, use as previousResponseId in next turn
        required enum OpenAIResponseStatusType      status;
        required Instant                            createdAt;
        required openaiModel                        model;
        required (OpenAIResponseOutputItem) List<>  output;            // output items (messages, tool calls)
        optional (OpenAIUsage)                      usage;
    }
}
